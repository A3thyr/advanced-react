{
  "compilerOptions": {
    "outDir": "./dist/",
    // Указываем директорию, для абсолютного импорта
    "baseUrl": ".",
    "noImplicitAny": true,
    // Указываем, на какую версию JS будет компилироваться
    "target": "es5",
    // Разрешаем JS-файлы (если вдруг нужно использовать js/jsx)
    "jsx": "react-jsx",
    // Пропускаем проверку типовых деклараций в node_modules
    "skipLibCheck": true,
    "allowJs": true,
    // Модуль и способ резолва
    // Если вы столкнетесь с проблемами при компиляции, попробуйте "moduleResolution": "Node".
    "module": "esnext",
    "moduleResolution": "node",
    // Для удобства при использовании commonjs и es-модулей
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
